    HATCH_OPEN,
    HATCH_CLOSE,
    HATCH_STAY,
} hatch_state_e;

typedef struct
{
    fp32 kp, ki, kd;
    fp32 set, get, err;
    fp32 max_out, max_iout;
    fp32 Pout, Iout, Dout, out;
} gimbal_PID_t;

typedef struct
{
    const motor_measure_t *gimbal_motor_measure;
    fp32 absolute_angle, absolute_angle_set;
    fp32 motor_gyro, motor_gyro_set;
    fp32 speed, current_set;
    int16_t give_current;
} gimbal_motor_t;

typedef struct
{
    fp32 roll, pitch, yaw;
} ins_data_t;

typedef struct
{
    const RC_ctrl_t *gimbal_rc_ctrl;
    const aimbot_task_t *gimbal_aimbot_point;
    const fp32 *gimbal_INT_angle_point;
    const fp32 *gimbal_INT_gyro_point;
    uint8_t aimbot_mode, aimbot_state, hatch_state;
    uint8_t gimbal_mode; /* 仅供现有底盘任务读取的兼容模式值。 */
    encoding_switch_t shoot_switch;
    ins_data_t ins_data;
    fp32 yaw; /* 不再由云台任务计算底盘跟随误差，保持兼容字段。 */
    fp32 yaw_set, pitch_set;
    gimbal_motor_t gimbal_yaw_motor, gimbal_pitch_motor;
    shoot_motor_t gimbal_trigger_motor;
    shoot_motor_t gimbal_fric_motor[2];
    gimbal_PID_t gimbal_angle_yaw_ins_pid;
    pid_type_def gimbal_speed_yaw_ins_pid;
    gimbal_PID_t gimbal_angle_pitch_ins_pid;
    pid_type_def gimbal_speed_pitch_ins_pid;
    pid_type_def gimbal_speed_trigger_pid;
    pid_type_def gimbal_speed_fric_pid[2];
} gimbal_control_t;

